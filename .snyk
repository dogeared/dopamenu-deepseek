# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JAVA-ORGGLASSFISHJAXB-20883142:
    - '*':
        reason: >-
          No published fix: jaxb-core 4.0.9 is the latest release and the
          upstream fix is unreleased. jaxb-runtime is a transitive runtime
          dependency of Hibernate and the app defines no XML entity mappings (no
          orm.xml/hbm.xml) and parses no untrusted XML, so the XXE path is not
          reachable. Re-evaluate when jaxb 4.0.10 ships.
        expires: 2027-02-19T00:00:00.000Z
        created: 2026-11-19T17:22:36.794Z
patch: {}
