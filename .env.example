# Copy to .env and adjust. Docker Compose reads .env automatically.

# Host ports
APP_PORT=8083
DB_PORT=5434
KEYCLOAK_PORT=8180

# Keycloak client
KEYCLOAK_CLIENT_ID=dopamenu-app

# Browser-facing Keycloak URL (also the token issuer).
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Back-channel URL used by the app. The app container joins the shared
# `local-infra` network, so it reaches Keycloak by container name; when running
# the app on the host, set this to http://localhost:8180 instead.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

KEYCLOAK_REALM=dopamenu
