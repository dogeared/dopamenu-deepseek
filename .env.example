# Copy to .env and adjust. Docker Compose reads .env automatically.

# Host ports
APP_PORT=8080
DB_PORT=5434
KEYCLOAK_PORT=8180

# Keycloak client
KEYCLOAK_CLIENT_ID=dopamenu-app
KEYCLOAK_CLIENT_SECRET=dopamenu-secret

# Browser-facing Keycloak URL (also the token issuer).
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Back-channel URL used by the app. Docker containers reach host services via
# host.docker.internal; when running the app on the host, keep localhost.
KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8180

KEYCLOAK_REALM=dopamenu
